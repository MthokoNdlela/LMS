@host = http://localhost:5279

### Register / login (both return a token)
POST {{host}}/api/auth/register
Content-Type: application/json

{ "username": "demo", "password": "Passw0rd!x" }

###
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "demo", "password": "Passw0rd!x" }

###
@token = {{login.response.body.$.token}}

### 1. Customer
POST {{host}}/api/customers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "Ann", "lastName": "Lee", "email": "ann@example.com", "phone": "+27111234567",
  "dateOfBirth": "1990-05-15", "nationalIdNumber": "9005150000000",
  "addressLine1": "1 Main Street", "city": "Cape Town", "postalCode": "8001"
}

### 2. Documents (metadata only), then verify each: IdDocument, ProofOfAddress, ProofOfIncome
POST {{host}}/api/customers/1/documents
Authorization: Bearer {{token}}
Content-Type: application/json

{ "type": "IdDocument", "fileName": "id.pdf", "contentType": "application/pdf", "storageReference": "blob://docs/id" }

###
POST {{host}}/api/customers/1/documents/1/review
Authorization: Bearer {{token}}
Content-Type: application/json

{ "status": "Verified" }

### 3. Loan products (product 1 is seeded)
GET {{host}}/api/loan-products
Authorization: Bearer {{token}}

### 4. Application: create -> submit -> review -> assess -> decide
POST {{host}}/api/loan-applications
Authorization: Bearer {{token}}
Content-Type: application/json

{ "customerId": 1, "loanProductId": 1, "requestedAmount": 20000, "termMonths": 12, "purpose": "Car repairs" }

###
POST {{host}}/api/loan-applications/1/submit
Authorization: Bearer {{token}}

###
POST {{host}}/api/loan-applications/1/review
Authorization: Bearer {{token}}

###
POST {{host}}/api/loan-applications/1/assessments
Authorization: Bearer {{token}}
Content-Type: application/json

{ "grossMonthlyIncome": 30000, "netMonthlyIncome": 24000, "monthlyExpenses": 8000, "monthlyDebtObligations": 2000 }

### Approving creates the loan and its repayment schedule
POST {{host}}/api/loan-applications/1/decision
Authorization: Bearer {{token}}
Content-Type: application/json

{ "approved": true }

### 5. Loan, schedule and payments
GET {{host}}/api/loans/1
Authorization: Bearer {{token}}

###
GET {{host}}/api/loans/1/schedule
Authorization: Bearer {{token}}

###
POST {{host}}/api/payments
Authorization: Bearer {{token}}
Content-Type: application/json

{ "loanId": 1, "amount": 1000, "method": "Eft", "reference": "EFT-001" }

### 6. Collections
GET {{host}}/api/loans?inArrears=true
Authorization: Bearer {{token}}

###
POST {{host}}/api/collection-activities
Authorization: Bearer {{token}}
Content-Type: application/json

{ "loanId": 1, "activityType": "PromiseToPay", "promisedAmount": 2500, "promisedDate": "2030-01-31", "notes": "Pays on payday" }

###
POST {{host}}/api/loans/1/late-fees
Authorization: Bearer {{token}}

### 7. Audit trail
GET {{host}}/api/audit-logs?entityType=Loan&entityId=1
Authorization: Bearer {{token}}
